# Copy this file to .env and fill in a key. .env is ignored by git.

# Key for the default provider (Groq).
GROQ_API_KEY=

# Key for --provider openai.
# OPENAI_API_KEY=

# Optional overrides. Defaults come from the selected provider.
# WHISPER_BRIEF_PROVIDER=groq
# WHISPER_BRIEF_BASE_URL=https://api.groq.com/openai/v1
# WHISPER_BRIEF_API_KEY=
# WHISPER_BRIEF_TRANSCRIBE_MODEL=whisper-large-v3-turbo
# WHISPER_BRIEF_CHAT_MODEL=llama-3.3-70b-versatile
# WHISPER_BRIEF_CHUNK_MINUTES=10
# WHISPER_BRIEF_CONCURRENCY=3
# WHISPER_BRIEF_MAX_RETRIES=4
# WHISPER_BRIEF_TIMEOUT=120
# WHISPER_BRIEF_JSON_MODE=json_object
# WHISPER_BRIEF_LANGUAGE=
# WHISPER_BRIEF_LOCAL_MODEL=small
